---
// The whole app is one page: a full-bleed three.js voxel map with a HUD,
// a list of today's events and an event card. All behaviour lives in
// src/scripts/app.js, which Astro bundles (three.js included) at build time.
// The site menu, its modals (contact, about, privacy, terms) and the cookie banner live
// in src/scripts/site.js, so they work before the map has loaded.
import '../styles/global.css';
import PrivacyPolicy from '../components/PrivacyPolicy.astro';
import Terms from '../components/Terms.astro';
import About from '../components/About.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AspCalendar from '../components/AspCalendar.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- Google Analytics. For visitors from the EU, EEA, UK and Switzerland (the edge worker sets
     data-consent="required" on <html>) it waits for a yes in the cookie banner; see src/scripts/site.js. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.loadAnalytics = function () {
    if (window.loadAnalytics.done) return;
    window.loadAnalytics.done = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TRZEWQT50E';
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', 'G-TRZEWQT50E');
  };
  (function () {
    // ?consent=eu previews the banner from anywhere.
    var required = document.documentElement.dataset.consent === 'required' || /[?&]consent=eu\b/.test(location.search);
    var choice = (document.cookie.match(/(?:^|; )8bm_consent=(yes|no)/) || [])[1] || null;
    window.siteConsent = { required: required, choice: choice };
    if (!required || choice === 'yes') window.loadAnalytics();
  })();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>8bit.NYC | Things to Do in NYC Today and Tomorrow</title>
<meta name="description" content="Things to do in NYC today and tomorrow on a retro 8-bit map. Music, art, comedy, nightlife, theater and trivia by neighborhood, plus Hoboken and Jersey City.">
<meta name="keywords" content="things to do in NYC, NYC events today, NYC events tonight, NYC events tomorrow, NYC events map, Brooklyn events, Manhattan events, Queens events, Hoboken events, Jersey City events, live music NYC, comedy shows NYC, art openings NYC, NYC nightlife, trivia nights NYC, NYC theater, 8-bit map, 8bit.NYC">
<link rel="canonical" href="https://8bit.nyc/">
<!-- Link previews (Facebook, iMessage, Slack, X). The image is a 1200x630 map shot in public/. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="8bit.NYC">
<meta property="og:url" content="https://8bit.nyc/">
<meta property="og:title" content="8bit.NYC | Things to Do in NYC Today and Tomorrow">
<meta property="og:description" content="Things to do in NYC today and tomorrow on a retro 8-bit map. Music, art, comedy, nightlife, theater and trivia by neighborhood, plus Hoboken and Jersey City.">
<meta property="og:image" content="https://8bit.nyc/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="8bit.NYC: a pixel art map of New York City covered in event pins">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="8bit.NYC | Things to Do in NYC Today and Tomorrow">
<meta name="twitter:description" content="Things to do in NYC today and tomorrow on a retro 8-bit map. Music, art, comedy, nightlife, theater and trivia by neighborhood, plus Hoboken and Jersey City.">
<meta name="twitter:image" content="https://8bit.nyc/og-image.png">
<meta name="twitter:image:alt" content="8bit.NYC: a pixel art map of New York City covered in event pins">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap">
</head>
<body>

<div id="map"></div>

<header class="hud">
  <div class="hud-top">
  <div class="brand box">
    <div class="brand-row">
    <h1><img class="pin-ico" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13 19' shape-rendering='crispEdges'%3E%3Cpath fill='%23ed1c24' d='M4 0h5v1h2v1h1v2h1v5h-1v2h-1v1h-1v2H9v2H8v2H7v1H6v-1H5v-2H4v-2H3v-2H2v-1H1V9H0V4h1V2h1V1h2z'/%3E%3Cpath fill='%23ffffff' d='M5 4h3v1h1v3H8v1H5V8H4V5h1z'/%3E%3C/svg%3E"><span>8bit<b>.nyc</b></span></h1>
    <button class="menu-btn" id="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
      <svg viewBox="0 0 7 6" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M0 0h7v1H0zM0 2.5h7v1H0zM0 5h7v1H0z"/></svg>
    </button>
    </div>
    <nav class="site-menu box" id="site-menu" aria-label="Site" hidden>
      <a href="#contact" data-modal="contact">CONTACT</a>
      <a href="#about" data-modal="about">ABOUT</a>
      <div class="menu-legal">
        <a href="#privacy" data-modal="privacy">PRIVACY POLICY</a>
        <a href="#terms" data-modal="terms">TERMS AND CONDITIONS</a>
        <a href="#disclaimer" data-modal="disclaimer">DISCLAIMER</a>
        <button type="button" id="cookie-settings" hidden>COOKIE SETTINGS</button>
      </div>
    </nav>
    <p><button id="today-date" class="day-btn" type="button" aria-pressed="false">TODAY</button><span id="today-count">LOADING</span></p>
  </div>
  <!-- Empty ad slot: opens the contact form on Ad/Event Inquiry. A booked ad replaces it with an <a class="ad box">. -->
  <button class="ad box is-empty" id="ad-slot" type="button" aria-label="Advertise your ad or event here: contact us">
    <small>AD</small>
    <strong>YOUR AD/EVENT HERE</strong>
  </button>
  </div>
  <div class="filter-row">
    <div class="src-filter">
      <button class="chip src-btn" id="src-btn" type="button" aria-expanded="false" aria-controls="src-menu" style="--cat:#ffffff">
        SOURCES<span id="src-summary">ALL</span><b aria-hidden="true">v</b>
      </button>
      <div class="src-menu box" id="src-menu" hidden>
        <div class="src-actions">
          <button type="button" id="src-all">SELECT ALL</button>
          <button type="button" id="src-none">DESELECT ALL</button>
        </div>
        <ul id="src-list" aria-label="Event sources"></ul>
      </div>
    </div>
    <div class="cat-filter">
      <button class="chip cat-btn" id="cat-btn" type="button" aria-expanded="false" aria-controls="cat-menu" style="--cat:#ffffff">
        CATEGORIES<span id="cat-summary">ALL</span><b aria-hidden="true">v</b>
      </button>
      <div class="src-menu cat-menu box" id="cat-menu" hidden>
        <div class="src-actions">
          <button type="button" id="cat-all">SELECT ALL</button>
          <button type="button" id="cat-none">DESELECT ALL</button>
        </div>
        <ul id="cat-list" aria-label="Event categories"></ul>
      </div>
    </div>
    <!-- + dropdown: a neighborhood to fly to, the subway map and alerts (src/scripts/subway.js),
         alternate side parking (src/scripts/asp.js) and MONSTER ATTACK! (src/scripts/monster.js) -->
    <div class="hood-filter">
      <button class="chip hood-btn" id="hood-btn" type="button" aria-expanded="false" aria-controls="hood-menu" aria-label="Neighborhoods, subway, parking and monsters" title="Neighborhoods, subway, parking and monsters">
        <svg viewBox="0 0 7 7" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M3 0h1v3h3v1H4v3H3V4H0V3h3z"/></svg>
      </button>
      <div class="src-menu hood-menu box" id="hood-menu" hidden>
        <button class="menu-sec" id="hood-sec-btn" type="button" aria-expanded="false" aria-controls="hood-sec">NEIGHBORHOODS<i aria-hidden="true"></i></button>
        <div class="menu-sec-body" id="hood-sec" hidden>
          <p class="hood-head">GO TO A NEIGHBORHOOD</p>
          <input id="hood-search" type="search" placeholder="Search" aria-label="Search neighborhoods" autocomplete="off" spellcheck="false">
          <ul id="hood-list" aria-label="Neighborhoods"></ul>
        </div>
        <button class="menu-sec" id="sub-sec-btn" type="button" aria-expanded="false" aria-controls="sub-sec">SUBWAY<i aria-hidden="true"></i></button>
        <div class="menu-sec-body" id="sub-sec" hidden>
          <button class="sub-mode" type="button" data-mode="map">SUBWAY MAP<span>ALL LINES</span></button>
          <button class="sub-mode" type="button" data-mode="active">ACTIVE ALERTS / DELAYS<span></span></button>
          <button class="sub-mode" type="button" data-mode="planned">PLANNED WORK<span></span></button>
          <div id="sub-out" aria-live="polite"></div>
        </div>
        <button class="menu-sec" id="asp-sec-btn" type="button" aria-expanded="false" aria-controls="asp-sec">ALT SIDE PARKING<em class="asp-badge" id="asp-badge"></em><i aria-hidden="true"></i></button>
        <div class="menu-sec-body" id="asp-sec" hidden>
          <div id="asp-out"></div>
          <button class="sub-mode" type="button" id="asp-show" aria-pressed="false">SHOW ON MAP<b>OFF</b></button>
          <a class="sub-link asp-cal" href="#asp" data-modal="asp">FULL YEAR CALENDAR</a>
          <a class="sub-link" href="https://www.nyc.gov/html/dot/html/motorist/alternate-side-parking.shtml" target="_blank" rel="noopener">EMERGENCY SUSPENSIONS AT NYC.GOV</a>
        </div>
        <button class="menu-sec" id="mon-sec-btn" type="button" aria-expanded="false" aria-controls="mon-sec">MONSTER ATTACK!<i aria-hidden="true"></i></button>
        <div class="menu-sec-body" id="mon-sec" hidden>
          <button class="sub-mode mon-go" type="button" data-monster="lizard" aria-pressed="false">GIGANTIC LIZARD<span>MIDTOWN</span></button>
          <button class="sub-mode mon-go" type="button" data-monster="ape" aria-pressed="false">RATHER LARGE APE<span>EMPIRE STATE</span></button>
          <button class="sub-mode mon-go" type="button" data-monster="alien" aria-pressed="false">ALIEN MONSTER<span>CENTRAL PARK</span></button>
          <button class="sub-mode mon-go" type="button" data-monster="fluff" aria-pressed="false">ALWAYS PUDGY FLUFF DUDE<span>UPPER WEST SIDE</span></button>
          <button class="sub-mode mon-go" type="button" data-monster="ufo" aria-pressed="false">UFO<span>OVER MANHATTAN</span></button>
          <button class="sub-mode mon-off" type="button" id="mon-off" hidden>CALL OFF THE ATTACK</button>
        </div>
      </div>
    </div>
    <button class="chip sub-chip" id="sub-chip" type="button" hidden title="Hide the subway lines"></button>
  </div>
</header>

<aside id="panel" aria-label="Events">
  <button id="panel-toggle" type="button" aria-expanded="false" aria-controls="event-list"><span hidden>Toggle event list</span></button>
  <div class="panel-head">
    <h2 id="list-title">TODAY</h2>
    <small id="list-hint">TAP A PIN OR A ROW</small>
  </div>
  <div class="list-wrap">
    <ol id="event-list"></ol>
    <button id="list-reset" type="button" hidden title="Back to the whole map and every listing">
      <svg class="reset-ico" viewBox="0 0 10 11" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M6 0h1v1H6zM6 1h2v1H6zM2 2h7v1H2zM1 3h1v1H1zM6 3h2v1H6zM0 4h1v1H0zM6 4h1v1H6zM0 5h1v1H0zM0 6h1v1H0zM9 6h1v1H9zM0 7h1v1H0zM9 7h1v1H9zM0 8h1v1H0zM9 8h1v1H9zM1 9h1v1H1zM8 9h1v1H8zM2 10h6v1H2z"/></svg>RESET
    </button>
    <p id="status" class="empty" role="status"></p>
  </div>
  <p class="panel-foot">LISTINGS FROM NYC.GOV EVENTS, LUMA, NYC STREET EVENTS, TICKETMASTER, SEATGEEK, ARTWRLD AND VENUES' OWN CALENDARS.</p>
</aside>

<section id="detail" class="box" hidden aria-live="polite"></section>

<!-- bottom left: the weather (src/scripts/weather.js) and, when switched on, the parking chip (src/scripts/asp.js) -->
<div class="corner">
  <button class="chip asp-chip" id="asp-chip" type="button" data-modal="asp" hidden title="Alternate side parking calendar"></button>
  <div class="wx">
    <div class="wx-card box" id="wx-card" hidden aria-live="polite"></div>
    <button class="wx-btn box" id="wx-btn" type="button" aria-expanded="false" aria-controls="wx-card" title="Weather"></button>
  </div>
</div>

<div class="controls box" role="toolbar" aria-label="Map controls">
  <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
  <button id="zoom-out" type="button" aria-label="Zoom out">-</button>
  <button id="rot-l" type="button" aria-label="Rotate left">&lt;</button>
  <button id="rot-r" type="button" aria-label="Rotate right">&gt;</button>
  <button id="home" type="button" aria-label="Reset view" title="Reset view">
    <svg class="reset-ico" viewBox="0 0 10 11" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M6 0h1v1H6zM6 1h2v1H6zM2 2h7v1H2zM1 3h1v1H1zM6 3h2v1H6zM0 4h1v1H0zM6 4h1v1H6zM0 5h1v1H0zM0 6h1v1H0zM9 6h1v1H9zM0 7h1v1H0zM9 7h1v1H9zM0 8h1v1H0zM9 8h1v1H9zM1 9h1v1H1zM8 9h1v1H8zM2 10h6v1H2z"/></svg>
  </button>
  <button id="pixel" type="button" aria-label="Change pixel size">PX<b>2X</b></button>
</div>
<p class="hint">DRAG TO MOVE · SCROLL TO ZOOM · RIGHT-DRAG TO TURN</p>


<dialog class="modal box" id="modal-contact" aria-labelledby="contact-title">
  <div class="modal-head"><h2 id="contact-title">CONTACT</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body">
    <form id="contact-form" novalidate>
      <p class="form-intro">Questions, comments or a listing that looks wrong? Send us a note.</p>
      <label for="cf-topic">TOPIC</label>
      <select id="cf-topic" name="topic" required>
        <option value="general">General Questions</option>
        <option value="comments">Comments</option>
        <option value="ad">Ad/Event Inquiry</option>
      </select>
      <div class="ad-info" id="ad-info" hidden>
        <p><b>ADVERTISE ON THE MAP.</b> The banner next to the 8bit.nyc header is open for ads and featured events. Tell us what you want to promote, the dates you have in mind and a link, and we will reply with options and rates.</p>
      </div>
      <label for="cf-name">NAME</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" maxlength="100" required>
      <label for="cf-email">EMAIL</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" maxlength="200" required>
      <label for="cf-message">MESSAGE</label>
      <textarea id="cf-message" name="message" rows="5" maxlength="5000" required></textarea>
      <!-- left empty by people, filled in by spam bots -->
      <div class="hp" aria-hidden="true"><label for="cf-website">WEBSITE</label><input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <p class="form-status" id="cf-status" role="status"></p>
      <button class="btn btn-go" type="submit">SEND</button>
      <p class="form-note">Ad/Event Inquiries go to sales@8bit.nyc, everything else to info@8bit.nyc. See our <a href="#privacy" data-modal="privacy">Privacy Policy</a>.</p>
    </form>
  </div>
</dialog>

<dialog class="modal box" id="modal-about" aria-labelledby="about-title">
  <div class="modal-head"><h2 id="about-title">ABOUT</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body legal"><About /></div>
</dialog>

<dialog class="modal box" id="modal-privacy" aria-labelledby="privacy-title">
  <div class="modal-head"><h2 id="privacy-title">PRIVACY POLICY</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body legal"><PrivacyPolicy /></div>
</dialog>

<dialog class="modal box" id="modal-terms" aria-labelledby="terms-title">
  <div class="modal-head"><h2 id="terms-title">TERMS AND CONDITIONS</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body legal"><Terms /></div>
</dialog>

<dialog class="modal box" id="modal-disclaimer" aria-labelledby="disclaimer-title">
  <div class="modal-head"><h2 id="disclaimer-title">DISCLAIMER</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body legal"><Disclaimer /></div>
</dialog>

<dialog class="modal box modal-wide" id="modal-asp" aria-labelledby="asp-title">
  <div class="modal-head"><h2 id="asp-title">ALTERNATE SIDE PARKING</h2><button class="modal-close" type="button" aria-label="Close">X</button></div>
  <div class="modal-body legal asp-cal-body"><AspCalendar /></div>
</dialog>

<section class="consent box" id="consent" aria-label="Cookie consent" hidden>
  <p>We use Google Analytics cookies to see how the map is used. They stay off unless you say yes. <a href="#privacy" data-modal="privacy">Privacy Policy</a></p>
  <div class="consent-actions">
    <button class="btn" type="button" data-consent="no">NO THANKS</button>
    <button class="btn btn-go" type="button" data-consent="yes">ACCEPT</button>
  </div>
</section>

<script>
  import '../scripts/site.js';
</script>
<script>
  import '../scripts/app.js';
</script>
</body>
</html>
