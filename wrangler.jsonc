// Cloudflare Workers deploy config: worker/index.js sits in front of the static Astro build in dist/
// (see the comment at the top of that file). Live is open to everyone.
// Used when Cloudflare builds this repo with `npx wrangler deploy`; the dev workflow adds
// --var SITE:dev and --var SITE_PASSWORD, which put the password on the dev site only.
{
  "name": "8bitmap",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Lets the contact form (POST /api/contact in worker/index.js) send email from 8bit.nyc.
  "send_email": [{ "name": "MAIL" }],
  "vars": {
    "SITE": "live"
  }
}
