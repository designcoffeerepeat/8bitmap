// Cloudflare Workers deploy config: worker/index.js sits in front of the static Astro build in dist/
// and asks for the shared password before serving the map (see the comment at the top of that file).
// Used when Cloudflare builds this repo with `npx wrangler deploy`; the dev workflow adds --var SITE:dev.
{
  "name": "8bitmap",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "SITE": "live",
    "SITE_PASSWORD": "8bit01",
    "DEV_URL": "https://8bitmap-dev.design-coffee-repeat.workers.dev"
  }
}
